# Copy locally; never commit actual passwords or keys.
POSTGRES_PASSWORD=replace-with-a-random-local-password
DATABASE_URL=postgresql+psycopg://canteen:replace-with-a-random-local-password@localhost:5432/canteen
PICKUP_HMAC_KEY=replace-with-at-least-32-random-characters
WEB_ORIGIN=http://localhost:5173
# Google ID-token audience. This must be the WEB application client ID (the same value the Android
# app passes as its server client ID), not the Android client ID. Client IDs are not secrets.
GOOGLE_OAUTH_CLIENT_ID=843116066974-77jb9r6g07hhkofhvobjtqfsln44a109.apps.googleusercontent.com
# Android client (package in.ac.aissms.canteen, debug SHA-1 registered). Android app only; not used by the API.
GOOGLE_ANDROID_CLIENT_ID=843116066974-1ld6em2iahd4m000prm66d4pkm258jmv.apps.googleusercontent.com
# Razorpay TEST mode. Key ID is public; put the secrets only in your local .env, never here.
RAZORPAY_KEY_ID=rzp_test_TwQNqlTSOdZrnq
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ENVIRONMENT=local
# Several merchant accounts (one per canteen) instead of the three RAZORPAY_* lines above:
# RAZORPAY_CREDENTIALS={"rzp_test_xxxxxxxx": {"key_secret": "...", "webhook_secret": "..."}}
# Live charges stay disabled; enabling requires ENVIRONMENT=production and separate approval.
ALLOW_LIVE_PAYMENTS=false
