# Staging configuration for infra/compose.staging.yml. Copy to .env.staging (gitignored).
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=replace-with-a-long-random-password
PICKUP_HMAC_KEY=replace-with-at-least-32-random-characters
ENVIRONMENT=staging
# Public HTTPS origin of the dashboard, exactly as staff type it (required outside local).
WEB_ORIGIN=https://canteen-staging.example.edu
# Address of the HTTPS reverse proxy as seen by the api container (trusted for X-Forwarded-For).
FORWARDED_ALLOW_IPS=172.16.0.0/12
GOOGLE_OAUTH_CLIENT_ID=843116066974-77jb9r6g07hhkofhvobjtqfsln44a109.apps.googleusercontent.com
# Razorpay TEST mode only on staging.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ALLOW_LIVE_PAYMENTS=false
REVIEW_REPORT_THRESHOLD=3
