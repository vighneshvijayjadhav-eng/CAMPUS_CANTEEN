# Copy locally; never commit actual passwords or keys.
POSTGRES_PASSWORD=replace-with-a-random-local-password
DATABASE_URL=postgresql+psycopg://canteen:replace-with-a-random-local-password@localhost:5432/canteen
PICKUP_HMAC_KEY=replace-with-at-least-32-random-characters
WEB_ORIGIN=http://localhost:5173
# Android OAuth client ID used to verify Google ID-token audience; leave unset until provisioned.
GOOGLE_OAUTH_CLIENT_ID=
ENVIRONMENT=local
